# Anthropic API key. Reviews run on Haiku 4.5, rewrites on Sonnet 5.
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string, used only for rate limiting.
# Use the pooled connection string ("-pooler" in the host) — the serverless
# HTTP driver expects it. The rate_limits table is created on first use.
# If this is unset the app still works; rate limiting is simply off.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
